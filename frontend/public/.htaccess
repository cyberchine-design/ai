# Thaimachine AI - Apache config

# Disable caching for index.html (so updates are seen immediately)
<FilesMatch "index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Cache static assets for 1 year (they have hashed filenames)
<FilesMatch "\.(js|css|svg|woff2?|png|jpg|jpeg|gif|ico)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Always serve version.json fresh
<FilesMatch "version\.json$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# SPA routing: send all requests to index.html
RewriteEngine On
RewriteBase /

# Don't rewrite real files / directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send everything else to index.html
RewriteRule ^ index.html [L]

# Enable gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# CORS for dictionaries (if loaded cross-origin)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
